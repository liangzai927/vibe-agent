# 复制为 .env 并填写。.env 已在 .gitignore 和 .dockerignore 中，不会被提交或打进镜像。

# ---- 主模型（OpenAI 兼容接口）----
# DeepSeek:   https://api.deepseek.com/v1        模型 deepseek-chat / deepseek-reasoner
# OpenAI:     https://api.openai.com/v1          模型 gpt-4o / gpt-5 ...
# 本地 Ollama: http://localhost:11434/v1         模型 qwen2.5-coder:14b
VA_API_KEY=
VA_BASE_URL=https://api.deepseek.com/v1
VA_MODEL=deepseek-chat

# ---- 视觉模型（可选：UI 还原度比对）----
# 主模型多数不支持读图（deepseek-chat 就不支持），做「截图 vs 设计稿」比对需要
# 单独配一个多模态模型。不配也能用 pixel_diff 做客观像素对比。
# ---- 允许读取工作区外的目录（可选）----
# 设计稿、需求文档常常不在项目里（下载目录、桌面）。
# 列在这里的目录读起来不再逐次询问；不列的每次都会把完整路径摆给你看再问。
# 分隔符用系统路径分隔符（macOS/Linux 是 :，Windows 是 ;），逗号也认。
# 只有图片和文档能越界；写操作和 read_file/grep 仍然锁死在项目内。
# VA_READ_DIRS=~/Desktop:~/Downloads
VA_VISION_MODEL=
VA_VISION_BASE_URL=
VA_VISION_API_KEY=

# ---- 行为 ----
# agent 的工作目录（默认：当前目录；容器里是 /workspace）
# VA_WORKSPACE=/path/to/your/repo
VA_TEMPERATURE=0
VA_MAX_ITERATIONS=50
VA_CONTEXT_BUDGET=60000
# 子 agent 最多嵌套几层。默认 1 = 主 agent 能委派，子 agent 不能再往下派
# VA_MAX_DELEGATE_DEPTH=1
# 1 = 危险命令 / 写文件不再询问
VA_AUTO_APPROVE=0
# 1 = 显示模型的思考过程（reasoner 类模型）
VA_SHOW_THINKING=1

# ---- 会话持久化 ----
# 默认写在 <工作区>/.va/sessions/
# VA_SESSION_DIR=

# ---- 渲染 ----
# 留空则自动探测：VA_BROWSER_EXECUTABLE → VA_BROWSER_CHANNEL → 系统 Chrome/Edge → Playwright Chromium
# VA_BROWSER_CHANNEL=chrome
# VA_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 容器里设 1 可在启动时自动补装 playwright + chromium
# VA_INSTALL_BROWSER=0

# ---- 容器专用（本地运行无影响）----
# 对齐到宿主机的用户/组 ID，避免挂载卷里生成 root 属主的文件
# VA_UID=1000
# VA_GID=1000
# agent 要提交代码时必须配，容器里没有你的 ~/.gitconfig
# GIT_USER_NAME=
# GIT_USER_EMAIL=
